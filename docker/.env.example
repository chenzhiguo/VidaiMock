# VidaiMock Docker Compose — optional environment overrides.
#
# Copy this file to `.env` (next to docker-compose.yml) and uncomment
# any line you want to override. Defaults match the batteries-included
# experience, so the unmodified compose file Just Works.

# Pin to a specific image version (recommended for CI / production rigs).
# Default: latest. Bootstrap pulls config from the same version tag.
# VIDAIMOCK_VERSION=0.2.8

# Host port to publish (container always listens on 8100 internally).
# Default: 8100.
# VIDAIMOCK_PORT=8100

# Log level: error | warn | info | debug.
# Default: info.
# VIDAIMOCK_LOG_LEVEL=info

# Base artificial latency per request, in milliseconds.
# Not settable via a top-level env var (latency is a struct in the
# binary's config). To enable, add `--latency 100` to the `command:`
# array in docker-compose.yml and restart.

# Lock the surface down: skip the binary's embedded providers/templates
# entirely; serve ONLY what's in ./config. Useful for production CI rigs
# and security review where you want zero ambiguity about what responds.
# Default: false (additive overrides — your ./config edits + bundled
# defaults both load, your files shadow embedded ones by name).
# VIDAIMOCK_ISOLATED=true
